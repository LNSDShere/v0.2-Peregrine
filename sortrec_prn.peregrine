const N: u32 = 16_000_000;

fn main() {
    var k: buf<u64>(N);
    var v: buf<u64>(N);
    var s: u64 = 88172645463325252;
    for i in 0..N {
        s = s * 6364136223846793005 + 1442695040888963407;
        k[i] = s;
        v[i] = s * 2654435761;
    }
    sort(k, v);
    var sumk: u64 = 0;
    var xk: u64 = 0;
    for i in 0..N {
        sumk += k[i];
        xk = xk ^ (k[i] + v[i]);
    }
    var asc: u32 = 0;
    for i in 1..N {
        if k[i] < k[i - 1] {
            asc += 1;
        }
    }
    print(sumk, " ", xk, " ", asc, " ", k[0], " ", k[N - 1], " ", N);
}
