        h = h ^ (h >> 23);
        h = h * 668265263;
        h = h ^ (h >> 5);
        h = h * 374761393;
        h = h ^ (h >> 13);
        h = h * 2654435761;
        h = h ^ (h >> 16);
        h = h * 1274126177;
        h = h ^ (h >> 7);
        h = h * 1013904223;
        h = h ^ (h >> 11);
        h = h * 1664525;
        h = h ^ (h >> 29);
        h = h * 2246822519;
        h = h ^ (h >> 19);
        h = h * 3266489917;
        h = h ^ (h >> 23);
        h = h * 668265263;
        h = h ^ (h >> 5);
        h = h * 374761393;
        h = h ^ (h >> 13);
        h = h * 2654435761;
        h = h ^ (h >> 16);
        h = h * 1274126177;
        h = h ^ (h >> 7);
        h = h * 1013904223;
        h = h ^ (h >> 11);
        h = h * 1664525;
        h = h ^ (h >> 29);
        h = h * 2246822519;
        h = h ^ (h >> 19);
        h = h * 3266489917;
        h = h ^ (h >> 23);
        h = h * 668265263;
        h = h ^ (h >> 5);
        h = h * 374761393;
